# Spotless & Sorted - Example environment variables
# Copy to .env.local (for local development) and fill values

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# (Optional) service role key for server-side operations only (keep secret)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Site
NEXT_PUBLIC_SITE_URL=https://your-site-url.com
SITE_URL=https://your-site-url.com
NEXT_PUBLIC_APP_NAME="Spotless & Sorted"

# Admin allowlist (single admin)
ADMIN_EMAIL=admin@example.com

# Nodemailer / SMTP (for booking & contact email notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp-user
SMTP_PASS=smtp-pass
EMAIL_FROM=spotlesssorted2@gmail.com

# WhatsApp placeholder (used for redirect after booking)
WHATSAPP_NUMBER=+00000000000

# Optional analytics / SEO
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_HEAP_ID=

# Environment
NODE_ENV=development

# Notes:
# - Never commit real secrets to the repo. Use your deployment platform's secret manager (Vercel env).
# - SUPABASE_SERVICE_ROLE_KEY (if used) must only be available to server-side code, never to the browser.
